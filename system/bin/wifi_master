#!/system/bin/sh
# ================================================================
# Galaxy Wi-Fi Master & Telephony Engine v1.0
# Device: Samsung Galaxy M32 5G (SM-M326B / MT6853 Dimensity 720)
# Radio Chip: MediaTek MT6631 / CONNSYS 2.0 (Mouton ASIC)
# Author: hoc
# ================================================================

CFG_FILE="/data/adb/galaxy_wifi_master.cfg"

ensure_cfg() {
    [ -f "$CFG_FILE" ] || cat <<EOF > "$CFG_FILE"
QAM256=1
CAM=0
AUTOPERF=1
DBDC=2
NSS=2
BW5G=3
TCP_CONG=bbr
COUNTRY=00
PROFILE=default
DIRECT_MODEM_HOTSPOT=1
EOF
}

sync_direct_routing() {
    # 1. Detect Active Cellular WAN Routing Tables
    ACTIVE_WAN_V4=$(ip -4 route show table all 2>/dev/null | grep -E '^default.*dev v4-rmnet' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)
    [ -z "$ACTIVE_WAN_V4" ] && ACTIVE_WAN_V4=$(ip -4 route show table all 2>/dev/null | grep -E '^default.*dev rmnet' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)
    [ -z "$ACTIVE_WAN_V4" ] && ACTIVE_WAN_V4=$(ip -4 route show table all 2>/dev/null | grep -E '^default.*dev ccmni' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)

    ACTIVE_WAN_V6=$(ip -6 route show table all 2>/dev/null | grep -E '^default.*dev rmnet' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)

    # 2. Add Link-Scope Subnet Return Routes & Rules in table main & 97 (Ensure bidirectional reachability)
    for iface in swlan0 ap0; do
        if ip link show "$iface" 2>/dev/null | grep -q "state UP"; then
            IP_SUBNET=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}')
            if [ -n "$IP_SUBNET" ]; then
                ip route add "$IP_SUBNET" dev "$iface" scope link table main 2>/dev/null || true
                ip route add "$IP_SUBNET" dev "$iface" scope link table 97 2>/dev/null || true
                NET_PREFIX=$(echo "$IP_SUBNET" | sed 's/\.[0-9]*\//.0\//')
                if [ -n "$NET_PREFIX" ] && ! ip rule show 2>/dev/null | grep -q "$NET_PREFIX.*lookup main"; then
                    ip rule add from all to "$NET_PREFIX" lookup main pref 7000 2>/dev/null || true
                fi
            fi
        fi
    done

    # Fallback static return rules for standard tethering subnets
    if ! ip rule show 2>/dev/null | grep -q "7001:"; then
        ip rule add from all to 192.168.43.0/24 lookup main pref 7001 2>/dev/null || true
    fi
    if ! ip rule show 2>/dev/null | grep -q "7002:"; then
        ip rule add from all to 192.168.42.0/24 lookup main pref 7002 2>/dev/null || true
    fi

    # 4. Direct Interface-to-Modem Routing Rules (pref 7010 & 7011)
    if [ -n "$ACTIVE_WAN_V4" ]; then
        CUR_SWLAN_TBL=$(ip rule show 2>/dev/null | grep -E "7010:.*iif swlan0" | awk '{print $NF}' | head -n1)
        if [ "$CUR_SWLAN_TBL" != "$ACTIVE_WAN_V4" ]; then
            ip rule del pref 7010 2>/dev/null || true
            ip rule add from all iif swlan0 lookup "$ACTIVE_WAN_V4" pref 7010 2>/dev/null || true
        fi

        CUR_AP_TBL=$(ip rule show 2>/dev/null | grep -E "7011:.*iif ap0" | awk '{print $NF}' | head -n1)
        if [ "$CUR_AP_TBL" != "$ACTIVE_WAN_V4" ]; then
            ip rule del pref 7011 2>/dev/null || true
            ip rule add from all iif ap0 lookup "$ACTIVE_WAN_V4" pref 7011 2>/dev/null || true
        fi
    fi

    # 5. IPv6 Direct Routing (pref 7010 & 7011)
    if [ -n "$ACTIVE_WAN_V6" ]; then
        CUR_SWLAN_V6=$(ip -6 rule show 2>/dev/null | grep -E "7010:.*iif swlan0" | awk '{print $NF}' | head -n1)
        if [ "$CUR_SWLAN_V6" != "$ACTIVE_WAN_V6" ]; then
            ip -6 rule del pref 7010 2>/dev/null || true
            ip -6 rule add from all iif swlan0 lookup "$ACTIVE_WAN_V6" pref 7010 2>/dev/null || true
        fi

        CUR_AP_V6=$(ip -6 rule show 2>/dev/null | grep -E "7011:.*iif ap0" | awk '{print $NF}' | head -n1)
        if [ "$CUR_AP_V6" != "$ACTIVE_WAN_V6" ]; then
            ip -6 rule del pref 7011 2>/dev/null || true
            ip -6 rule add from all iif ap0 lookup "$ACTIVE_WAN_V6" pref 7011 2>/dev/null || true
        fi
    fi
}

get_cfg_val() {
    ensure_cfg
    grep "^$1=" "$CFG_FILE" 2>/dev/null | cut -d '=' -f 2- | tr -d '\r\n'
}

set_cfg_val() {
    ensure_cfg
    if grep -q "^$1=" "$CFG_FILE" 2>/dev/null; then
        sed -i "s|^$1=.*|$1=$2|" "$CFG_FILE"
    else
        echo "$1=$2" >> "$CFG_FILE"
    fi
}

cmd_status() {
    ensure_cfg

    # 1. Interface wlan0
    WLAN_STATE="DOWN"
    WLAN_IP=""
    WLAN_MAC="10:ec:81:e1:70:b0"
    IP_OUT=$(ip -4 addr show wlan0 2>/dev/null)
    if [ -n "$IP_OUT" ]; then
        WLAN_STATE=$(echo "$IP_OUT" | grep -o 'state [A-Z]*' | awk '{print $2}')
        [ -z "$WLAN_STATE" ] && WLAN_STATE="UP"
        WLAN_IP=$(echo "$IP_OUT" | grep 'inet ' | awk '{print $2}' | cut -d '/' -f 1)
    fi
    MAC_OUT=$(cat /sys/class/net/wlan0/address 2>/dev/null)
    [ -n "$MAC_OUT" ] && WLAN_MAC="$MAC_OUT"

    # Gateway & DNS
    GW=$(ip route show dev wlan0 2>/dev/null | grep 'default via' | awk '{print $3}' | head -n 1)
    DNS1=$(getprop net.dns1)
    DNS2=$(getprop net.dns2)

    # 2. Wi-Fi Connection Telemetry
    SSID=""
    BSSID=""
    RSSI="-127"
    FREQ="-1"
    SPEED="-1"
    WIFI_STD="0"
    DUMP_WIFI=$(dumpsys wifi 2>/dev/null)
    INFO_LINE=$(echo "$DUMP_WIFI" | grep 'mWifiInfo' | head -n 1)
    if [ -n "$INFO_LINE" ]; then
        SSID=$(echo "$INFO_LINE" | sed -n 's/.*SSID: \([^,]*\),.*/\1/p' | sed 's/^<unknown ssid>$//; s/^"//; s/"$//')
        BSSID=$(echo "$INFO_LINE" | sed -n 's/.*BSSID: \([^,]*\),.*/\1/p' | sed 's/^<none>$//')
        RSSI=$(echo "$INFO_LINE" | sed -n 's/.*RSSI: \([^,]*\),.*/\1/p')
        FREQ=$(echo "$INFO_LINE" | sed -n 's/.*Frequency: \([0-9]*\)MHz.*/\1/p')
        SPEED=$(echo "$INFO_LINE" | sed -n 's/.*Link speed: \([0-9]*\)Mbps.*/\1/p')
        WIFI_STD=$(echo "$INFO_LINE" | sed -n 's/.*Wi-Fi standard: \([0-9]*\),.*/\1/p')
    fi
    [ "$SSID" = "<none>" ] && SSID=""
    SSID=$(echo "$SSID" | tr -d '"')
    [ -z "$RSSI" ] && RSSI="-127"
    [ -z "$FREQ" ] && FREQ="-1"
    [ -z "$SPEED" ] && SPEED="-1"

    # Calculate channel from frequency
    CHANNEL="0"
    BAND="2.4 GHz"
    if [ "$FREQ" -ge 2412 ] && [ "$FREQ" -le 2484 ]; then
        CHANNEL=$(( (FREQ - 2407) / 5 ))
        [ "$FREQ" -eq 2484 ] && CHANNEL=14
        BAND="2.4 GHz"
    elif [ "$FREQ" -ge 5170 ] && [ "$FREQ" -le 5825 ]; then
        CHANNEL=$(( (FREQ - 5000) / 5 ))
        BAND="5 GHz (VHT80)"
    fi

    # 3. Hardware & Driver Parameters
    QAM256="0"
    DBDC="0"
    STAVHT="1"
    APVHT="1"
    NSS_VAL="1"
    AP5G_NSS_VAL="1"
    AP_BW_VAL="2"
    if [ -f /proc/net/wlan/cfg ]; then
        QAM256=$(grep "^Probe256QAM|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -z "$QAM256" ] && QAM256=$(grep "^D:Probe256QAM|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        DBDC=$(grep "^D:DbdcMode|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        STAVHT=$(grep "^StaVHT|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        APVHT=$(grep "^ApVHT|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        n_out=$(grep "^Nss|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -z "$n_out" ] && n_out=$(grep "^D:Nss|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -n "$n_out" ] && NSS_VAL="$n_out"
        ap5g_nss=$(grep "^Ap5gNss|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -z "$ap5g_nss" ] && ap5g_nss=$(grep "^D:Ap5gNss|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -n "$ap5g_nss" ] && AP5G_NSS_VAL="$ap5g_nss"
        ap_bw=$(grep "^ApBw|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -z "$ap_bw" ] && ap_bw=$(grep "^D:ApBw|" /proc/net/wlan/cfg 2>/dev/null | cut -d '|' -f 2)
        [ -n "$ap_bw" ] && AP_BW_VAL="$ap_bw"
    fi
    [ -z "$QAM256" ] && QAM256="0"
    [ -z "$DBDC" ] && DBDC="0"
    MAX_5G_PHY=433
    if [ "$NSS_VAL" = "2" ] || [ "$AP5G_NSS_VAL" = "2" ]; then
        if [ "$AP_BW_VAL" = "3" ]; then
            MAX_5G_PHY=1733
        else
            MAX_5G_PHY=866
        fi
    fi

    AUTOPERF="0"
    if grep -q "1: always enable" /proc/net/wlan/autoPerfCfg 2>/dev/null; then
        AUTOPERF=$(get_cfg_val AUTOPERF)
        [ -z "$AUTOPERF" ] && AUTOPERF="1"
    fi

    CAM_VAL=$(get_cfg_val CAM)
    [ -z "$CAM_VAL" ] && CAM_VAL="0"

    TCP_CONG=$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)
    [ -z "$TCP_CONG" ] && TCP_CONG="bbr"

    COUNTRY_CODE="00"
    C_OUT=$(cat /proc/net/wlan/country 2>/dev/null | grep 'Current Country Code' | awk '{print $4}')
    [ -n "$C_OUT" ] && COUNTRY_CODE="$C_OUT"

    # 4. Hotspot (SoftAP) Telemetry
    SAP_ACTIVE=false
    SAP_IFACE="swlan0"
    if ip link show swlan0 2>/dev/null | grep -q "state UP"; then
        SAP_ACTIVE=true
    elif ip link show ap0 2>/dev/null | grep -q "state UP"; then
        SAP_ACTIVE=true
        SAP_IFACE="ap0"
    fi

    # Read SoftAP Config
    SAP_XML="/data/misc/apexdata/com.android.wifi/WifiConfigStoreSoftAp.xml"
    SAP_SSID="Galaxy M32 5G"
    SAP_PASS="1234567890"
    SAP_BAND="5 GHz"
    SAP_CHANNEL="149"
    if [ -f "$SAP_XML" ]; then
        s_ssid=$(sed -n 's/.*<string name="WifiSsid">&quot;\(.*\)&quot;<\/string>.*/\1/p' "$SAP_XML" | head -n 1)
        [ -n "$s_ssid" ] && SAP_SSID="$s_ssid"
        s_pass=$(sed -n 's/.*<string name="Passphrase">\(.*\)<\/string>.*/\1/p' "$SAP_XML" | head -n 1)
        [ -n "$s_pass" ] && SAP_PASS="$s_pass"
        s_band=$(sed -n 's/.*<int name="Band" value="\([0-9]*\)" \/>.*/\1/p' "$SAP_XML" | head -n 1)
        if [ "$s_band" = "1" ]; then
            SAP_BAND="2.4 GHz"
        else
            SAP_BAND="5 GHz"
        fi
        s_chan=$(sed -n 's/.*<int name="Channel" value="\([0-9]*\)" \/>.*/\1/p' "$SAP_XML" | head -n 1)
        [ -n "$s_chan" ] && SAP_CHANNEL="$s_chan"
    fi

    # SoftAP Connected Clients
    CLIENTS_JSON="[]"
    NEIGH_OUT=$(ip neigh show dev "$SAP_IFACE" 2>/dev/null | grep -E 'REACHABLE|DELAY|STALE')
    if [ -n "$NEIGH_OUT" ]; then
        CLIENTS_JSON="["
        FIRST=1
        while IFS= read -r line; do
            c_ip=$(echo "$line" | awk '{print $1}')
            c_mac=$(echo "$line" | awk '{print $5}')
            if [ -n "$c_ip" ] && [ -n "$c_mac" ]; then
                [ $FIRST -eq 0 ] && CLIENTS_JSON="$CLIENTS_JSON,"
                CLIENTS_JSON="$CLIENTS_JSON{\"ip\":\"$c_ip\",\"mac\":\"$c_mac\"}"
                FIRST=0
            fi
        done <<EOF
$NEIGH_OUT
EOF
        CLIENTS_JSON="$CLIENTS_JSON]"
    fi

    # Blocked MACs from iptables
    BLOCKED_JSON="[]"
    DROP_RULES=$(iptables -S FORWARD 2>/dev/null | grep -- '--mac-source')
    if [ -n "$DROP_RULES" ]; then
        BLOCKED_JSON="["
        FIRST=1
        while IFS= read -r r; do
            b_mac=$(echo "$r" | sed -n 's/.*--mac-source \([0-9a-fA-F:]*\).*/\1/p')
            if [ -n "$b_mac" ]; then
                [ $FIRST -eq 0 ] && BLOCKED_JSON="$BLOCKED_JSON,"
                BLOCKED_JSON="$BLOCKED_JSON\"$b_mac\""
                FIRST=0
            fi
        done <<EOF
$DROP_RULES
EOF
        BLOCKED_JSON="$BLOCKED_JSON]"
    fi

    # DFS & Channel Unlock Check
    DFS_UNLOCKED=true
    if [ -f /vendor/etc/wifi/indoorchannel.info ]; then
        LINES=$(wc -l < /vendor/etc/wifi/indoorchannel.info 2>/dev/null)
        [ "$LINES" -gt 5 ] && DFS_UNLOCKED=false
    fi

    # Network Stats for wlan0
    RX_BYTES=0
    TX_BYTES=0
    if [ -f /proc/net/dev ]; then
        DEV_LINE=$(grep 'wlan0:' /proc/net/dev 2>/dev/null | head -n 1)
        if [ -n "$DEV_LINE" ]; then
            RX_BYTES=$(echo "$DEV_LINE" | awk '{print $2}' | tr -d '\r\n')
            TX_BYTES=$(echo "$DEV_LINE" | awk '{print $10}' | tr -d '\r\n')
        fi
    fi

    DRIVER_VER=$(getprop vendor.wlan.driver.version | tr -d '"')
    FW_VER=$(getprop vendor.wlan.firmware.version | tr -d '"')
    CHIP_ID="MT6631 (0x6631) CONNSYS 2.0"
    CURRENT_PROFILE=$(get_cfg_val PROFILE)
    [ -z "$CURRENT_PROFILE" ] && CURRENT_PROFILE="default"

    # 5. Direct Modem Passthrough Telemetry
    DM_CFG=$(get_cfg_val DIRECT_MODEM_HOTSPOT)
    [ -z "$DM_CFG" ] && DM_CFG="1"
    DM_ENABLED=$([ "$DM_CFG" = "1" ] && echo true || echo false)
    DM_ACTIVE=false
    if iptables -w 2 -L FORWARD -n 2>/dev/null | grep -q "PURE_FORWARD"; then
        DM_ACTIVE=true
    fi

    ACTIVE_WAN_V4=$(ip -4 route show table all 2>/dev/null | grep -E '^default.*dev v4-rmnet' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)
    [ -z "$ACTIVE_WAN_V4" ] && ACTIVE_WAN_V4=$(ip -4 route show table all 2>/dev/null | grep -E '^default.*dev rmnet' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)
    [ -z "$ACTIVE_WAN_V4" ] && ACTIVE_WAN_V4=$(ip -4 route show table all 2>/dev/null | grep -E '^default.*dev ccmni' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)
    [ -z "$ACTIVE_WAN_V4" ] && ACTIVE_WAN_V4="none"

    ACTIVE_WAN_V6=$(ip -6 route show table all 2>/dev/null | grep -E '^default.*dev rmnet' | sed -n 's/.*table \([^ ]*\).*/\1/p' | head -n1)
    [ -z "$ACTIVE_WAN_V6" ] && ACTIVE_WAN_V6="none"

    SAP_IP=$(ip -4 addr show "$SAP_IFACE" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d '/' -f 1)
    [ -z "$SAP_IP" ] && SAP_IP="none"

    TTL_ACTIVE=false
    if [ "$(cat /proc/sys/net/ipv4/ip_default_ttl 2>/dev/null)" = "64" ] || iptables -w 2 -t mangle -L POSTROUTING -n 2>/dev/null | grep -q "TTL set to 64"; then
        TTL_ACTIVE=true
    fi

    MSS_ACTIVE=false
    if iptables -w 2 -t mangle -L FORWARD -n 2>/dev/null | grep -q "TCPMSS clamp to PMTU"; then
        MSS_ACTIVE=true
    fi

    DNS_ACTIVE=false
    if iptables -w 2 -t nat -L PREROUTING -n 2>/dev/null | grep -q "to:1.1.1.1:53"; then
        DNS_ACTIVE=true
    fi

    BPF_ACTIVE=false
    if [ "$(settings get global tether_offload_disabled 2>/dev/null)" = "1" ]; then
        BPF_ACTIVE=true
    fi

    DUN_ACTIVE=false
    if [ "$(settings get global tether_dun_required 2>/dev/null)" = "0" ]; then
        DUN_ACTIVE=true
    fi

    FWD_PKTS=0
    FWD_BYTES="0"
    FWD_STATS=$(iptables -w 2 -L FORWARD -v -n 2>/dev/null | grep "PURE_FORWARD" | head -n 1)
    if [ -n "$FWD_STATS" ]; then
        FWD_PKTS=$(echo "$FWD_STATS" | awk '{print $1}')
        FWD_BYTES=$(echo "$FWD_STATS" | awk '{print $2}')
    fi

    # Emit JSON
    cat <<EOF
{
  "success": true,
  "telemetry": {
    "interface": "wlan0",
    "state": "$WLAN_STATE",
    "ip": "$WLAN_IP",
    "mac": "$WLAN_MAC",
    "gateway": "$GW",
    "dns1": "$DNS1",
    "dns2": "$DNS2",
    "ssid": "$SSID",
    "bssid": "$BSSID",
    "rssi": $RSSI,
    "frequency": $FREQ,
    "channel": $CHANNEL,
    "band": "$BAND",
    "link_speed_mbps": $SPEED,
    "wifi_standard": "$WIFI_STD",
    "rx_bytes": $RX_BYTES,
    "tx_bytes": $TX_BYTES
  },
  "features": {
    "qam256": $QAM256,
    "cam_mode": $CAM_VAL,
    "auto_perf": $AUTOPERF,
    "dbdc_mode": $DBDC,
    "dfs_unlocked": $DFS_UNLOCKED,
    "nss": $NSS_VAL,
    "ap_5g_nss": $AP5G_NSS_VAL,
    "ap_bw": $AP_BW_VAL,
    "max_5g_phy_mbps": $MAX_5G_PHY,
    "tcp_congestion": "$TCP_CONG",
    "country_code": "$COUNTRY_CODE",
    "active_profile": "$CURRENT_PROFILE"
  },
  "hotspot": {
    "active": $SAP_ACTIVE,
    "interface": "$SAP_IFACE",
    "ssid": "$SAP_SSID",
    "passphrase": "$SAP_PASS",
    "band": "$SAP_BAND",
    "channel": "$SAP_CHANNEL",
    "clients": $CLIENTS_JSON,
    "blocked_macs": $BLOCKED_JSON
  },
  "direct_modem": {
    "enabled": $DM_ENABLED,
    "active": $DM_ACTIVE,
    "upstream_v4": "$ACTIVE_WAN_V4",
    "upstream_v6": "$ACTIVE_WAN_V6",
    "hotspot_iface": "$SAP_IFACE",
    "hotspot_ip": "$SAP_IP",
    "ttl_normalized": $TTL_ACTIVE,
    "mss_clamped": $MSS_ACTIVE,
    "dns_shield": $DNS_ACTIVE,
    "bpf_disabled": $BPF_ACTIVE,
    "dun_bypassed": $DUN_ACTIVE,
    "pkts_forwarded": "$FWD_PKTS",
    "bytes_forwarded": "$FWD_BYTES"
  },
  "hardware": {
    "chip": "$CHIP_ID",
    "soc": "MediaTek MT6853 Dimensity 720",
    "driver_version": "$DRIVER_VER",
    "firmware_version": "$FW_VER"
  }
}
EOF
}

cmd_set_qam256() {
    VAL="${1:-1}"
    if [ -f /proc/net/wlan/cfg ]; then
        echo "Probe256QAM $VAL" > /proc/net/wlan/cfg 2>/dev/null
    fi
    set_cfg_val QAM256 "$VAL"
    echo "{\"success\":true,\"qam256\":$VAL,\"message\":\"256-QAM (TurboQAM) set to $VAL\"}"
}

cmd_set_cam() {
    VAL="${1:-1}"
    if [ -w /proc/net/wlan/setCAM ]; then
        echo "$VAL" > /proc/net/wlan/setCAM 2>/dev/null
    fi
    set_cfg_val CAM "$VAL"
    echo "{\"success\":true,\"cam\":$VAL,\"message\":\"Continuous Access Mode (CAM) set to $VAL\"}"
}

cmd_set_autoperf() {
    VAL="${1:-1}"
    if [ -w /proc/net/wlan/autoPerfCfg ]; then
        echo "ForceEnable:$VAL" > /proc/net/wlan/autoPerfCfg 2>/dev/null
    fi
    set_cfg_val AUTOPERF "$VAL"
    echo "{\"success\":true,\"autoperf\":$VAL,\"message\":\"Auto Performance Monitor set to $VAL\"}"
}

cmd_set_dbdc() {
    VAL="${1:-2}"
    if [ -f /proc/net/wlan/cfg ]; then
        echo "DbdcMode $VAL" > /proc/net/wlan/cfg 2>/dev/null
    fi
    set_cfg_val DBDC "$VAL"
    echo "{\"success\":true,\"dbdc\":$VAL,\"message\":\"DBDC Concurrency set to $VAL\"}"
}

cmd_set_nss() {
    VAL="${1:-2}"
    if [ -f /proc/net/wlan/driver ]; then
        echo "SET_NSS $VAL" > /proc/net/wlan/driver 2>/dev/null
    fi
    if [ -f /proc/net/wlan/cfg ]; then
        echo "Nss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap6gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap5gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap2gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Go6gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Go5gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Go2gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Sta1Nss $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Sta5gNss $VAL" > /proc/net/wlan/cfg 2>/dev/null
    fi
    set_cfg_val NSS "$VAL"
    MAX_PHY=$([ "$VAL" = "2" ] && echo 866 || echo 433)
    echo "{\"success\":true,\"nss\":$VAL,\"max_speed\":$MAX_PHY,\"message\":\"Spatial Streams (MIMO) set to ${VAL}x${VAL} ($([ "$VAL" = "2" ] && echo "866 Mbps Boost" || echo "433 Mbps Standard"))\"}"
}

cmd_revert() {
    # Revert all settings to stock Samsung / MediaTek factory defaults
    if [ -f /proc/net/wlan/driver ]; then
        echo "SET_NSS 1" > /proc/net/wlan/driver 2>/dev/null
        echo "SET_PWR_CTRL 1" > /proc/net/wlan/driver 2>/dev/null
    fi
    if [ -f /proc/net/wlan/cfg ]; then
        echo "Probe256QAM 0" > /proc/net/wlan/cfg 2>/dev/null
        echo "Nss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap6gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap5gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap2gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Go6gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Go5gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Go2gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Sta1Nss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "Sta5gNss 1" > /proc/net/wlan/cfg 2>/dev/null
        echo "DbdcMode 0" > /proc/net/wlan/cfg 2>/dev/null
        echo "ApBw 2" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap5gBw 2" > /proc/net/wlan/cfg 2>/dev/null
        echo "SapOverwriteAcsChnlBw 0" > /proc/net/wlan/cfg 2>/dev/null
    fi
    if [ -f /proc/net/wlan/autoPerfCfg ]; then
        echo "ForceEnable:0" > /proc/net/wlan/autoPerfCfg 2>/dev/null
    fi
    echo "cubic" > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null

    cat <<EOF > "$CFG_FILE"
QAM256=0
CAM=0
AUTOPERF=0
DBDC=0
NSS=1
BW5G=2
TCP_CONG=cubic
COUNTRY=00
PROFILE=stock
EOF
    echo "{\"success\":true,\"message\":\"All Wi-Fi settings successfully reverted to stock factory defaults (1x1 SISO 433Mbps, 256-QAM off, standard power save)\"}"
}

cmd_set_bw5g() {
    VAL="${1:-2}"
    if [ -f /proc/net/wlan/cfg ]; then
        echo "ApBw $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Ap5gBw $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "Sta5gBw $VAL" > /proc/net/wlan/cfg 2>/dev/null
    fi
    set_cfg_val BW5G "$VAL"
    BW_TEXT=$([ "$VAL" = "3" ] && echo "160 MHz Ultra" || echo "80 MHz Standard")
    echo "{\"success\":true,\"bw\":$VAL,\"bandwidth\":\"$BW_TEXT\",\"message\":\"5GHz Channel Bandwidth Mode set to $BW_TEXT\"}"
}

cmd_set_country() {
    CC="${1:-00}"
    cmd wifi set-country-code "$CC" 2>/dev/null
    echo "$CC" > /proc/net/wlan/country 2>/dev/null
    set_cfg_val COUNTRY "$CC"
    echo "{\"success\":true,\"country\":\"$CC\",\"message\":\"Regulatory Country Code set to $CC\"}"
}

cmd_set_tcp() {
    CONG="${1:-bbr}"
    echo "$CONG" > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null
    set_cfg_val TCP_CONG "$CONG"
    echo "{\"success\":true,\"tcp_congestion\":\"$CONG\",\"message\":\"TCP Congestion Control set to $CONG\"}"
}

cmd_set_wlan_cfg() {
    KEY="$1"
    VAL="$2"
    if [ -n "$KEY" ] && [ -n "$VAL" ] && [ -f /proc/net/wlan/cfg ]; then
        echo "$KEY $VAL" > /proc/net/wlan/cfg 2>/dev/null
        echo "{\"success\":true,\"key\":\"$KEY\",\"value\":\"$VAL\",\"message\":\"Driver parameter $KEY set to $VAL\"}"
    else
        echo "{\"success\":false,\"error\":\"Missing key or value or /proc/net/wlan/cfg unavailable\"}"
    fi
}

cmd_set_wifi() {
    ACTION="${1:-restart}"
    case "$ACTION" in
        enable)
            svc wifi enable
            ;;
        disable)
            svc wifi disable
            ;;
        restart)
            svc wifi disable
            sleep 1
            svc wifi enable
            ;;
    esac
    echo "{\"success\":true,\"action\":\"$ACTION\",\"message\":\"Wi-Fi $ACTION command executed\"}"
}

cmd_set_hotspot() {
    ACTION="${1:-restart}"
    if [ "$ACTION" = "enable" ] || [ "$ACTION" = "1" ] || [ "$ACTION" = "start" ] || [ "$ACTION" = "on" ]; then
        [ -e /dev/wmtWifi ] && echo 1 > /dev/wmtWifi 2>/dev/null
        SAP_XML="/data/misc/apexdata/com.android.wifi/WifiConfigStoreSoftAp.xml"
        SSID=$(grep 'name="WifiSsid"' "$SAP_XML" 2>/dev/null | sed -e 's/.*&quot;\(.*\)&quot;.*/\1/' -e 's/.*<string name="WifiSsid">\(.*\)<\/string>.*/\1/' | head -n 1)
        [ -z "$SSID" ] && SSID="Galaxy M32 5G 70B0"
        PASS=$(grep 'name="Passphrase"' "$SAP_XML" 2>/dev/null | sed -e 's/.*<string name="Passphrase">\(.*\)<\/string>.*/\1/' | head -n 1)
        [ -z "$PASS" ] && PASS="1234567890"
        BAND=$(grep -A 2 '<BandChannel>' "$SAP_XML" 2>/dev/null | grep 'name="Band"' | sed -e 's/.*value="\([0-9]*\)".*/\1/' | head -n 1)
        BAND_ARG="-b 5"
        [ "$BAND" = "1" ] && BAND_ARG="-b 2"
        cmd wifi start-softap "$SSID" wpa2 "$PASS" $BAND_ARG 2>/dev/null || svc wifi startSoftAp 2>/dev/null || true
        sync_direct_routing 2>/dev/null || true
    else
        cmd wifi stop-softap 2>/dev/null || svc wifi stopSoftAp 2>/dev/null || true
    fi
    echo "{\"success\":true,\"action\":\"$ACTION\",\"message\":\"Hotspot $ACTION command sent\"}"
}

cmd_set_hotspot_cfg() {
    NEW_SSID="$1"
    NEW_PASS="$2"
    NEW_BAND="$3" # "2.4" or "5"
    NEW_CHAN="$4"

    SAP_XML="/data/misc/apexdata/com.android.wifi/WifiConfigStoreSoftAp.xml"
    if [ -f "$SAP_XML" ]; then
        [ -n "$NEW_SSID" ] && sed -i "s|<string name=\"WifiSsid\">.*<\/string>|<string name=\"WifiSsid\">&quot;$NEW_SSID&quot;<\/string>|" "$SAP_XML"
        [ -n "$NEW_PASS" ] && sed -i "s|<string name=\"Passphrase\">.*<\/string>|<string name=\"Passphrase\">$NEW_PASS<\/string>|" "$SAP_XML"
        if [ "$NEW_BAND" = "2.4" ]; then
            sed -i 's|<int name="Band" value="[0-9]*" \/>|<int name="Band" value="1" \/>|' "$SAP_XML"
        elif [ "$NEW_BAND" = "5" ]; then
            sed -i 's|<int name="Band" value="[0-9]*" \/>|<int name="Band" value="2" \/>|' "$SAP_XML"
        fi
        [ -n "$NEW_CHAN" ] && sed -i "s|<int name=\"Channel\" value=\"[0-9]*\" \/>|<int name=\"Channel\" value=\"$NEW_CHAN\" \/>|" "$SAP_XML"
    fi
    echo "{\"success\":true,\"ssid\":\"$NEW_SSID\",\"band\":\"$NEW_BAND\",\"message\":\"Hotspot configuration updated. Restart hotspot to apply.\"}"
}

cmd_block_mac() {
    MAC="$1"
    if [ -n "$MAC" ]; then
        iptables -D FORWARD -m mac --mac-source "$MAC" -j DROP 2>/dev/null
        iptables -I FORWARD -m mac --mac-source "$MAC" -j DROP
        echo "{\"success\":true,\"mac\":\"$MAC\",\"message\":\"Client $MAC blocked\"}"
    else
        echo "{\"success\":false,\"error\":\"Missing MAC address\"}"
    fi
}

cmd_unblock_mac() {
    MAC="$1"
    if [ -n "$MAC" ]; then
        iptables -D FORWARD -m mac --mac-source "$MAC" -j DROP 2>/dev/null
        echo "{\"success\":true,\"mac\":\"$MAC\",\"message\":\"Client $MAC unblocked\"}"
    else
        echo "{\"success\":false,\"error\":\"Missing MAC address\"}"
    fi
}

cmd_apply_profile() {
    PROF="${1:-default}"
    case "$PROF" in
        gaming)
            # Ultra-Low Latency Gaming Profile
            cmd_set_cam 1 >/dev/null
            cmd_set_qam256 1 >/dev/null
            cmd_set_autoperf 1 >/dev/null
            cmd_set_nss 2 >/dev/null
            cmd_set_bw5g 3 >/dev/null
            cmd_set_tcp bbr >/dev/null
            set_cfg_val PROFILE "gaming"
            echo "{\"success\":true,\"profile\":\"gaming\",\"message\":\"Gaming Mode Active: Zero-Jitter Continuous Access Mode (CAM) enabled, 256-QAM enabled, 2x2 MIMO 866 Mbps Boost, TCP BBR active\"}"
            ;;
        max_throughput)
            # Maximum Bandwidth & Speed Profile
            cmd_set_cam 0 >/dev/null
            cmd_set_qam256 1 >/dev/null
            cmd_set_autoperf 1 >/dev/null
            cmd_set_dbdc 2 >/dev/null
            cmd_set_nss 2 >/dev/null
            cmd_set_bw5g 3 >/dev/null
            cmd_set_tcp bbr >/dev/null
            # Buffer & aggregation tuning
            echo "TxMaxAmsduInAmpduLen 8192" > /proc/net/wlan/cfg 2>/dev/null
            echo "NetifStopTh 256" > /proc/net/wlan/cfg 2>/dev/null
            echo "NetifStartTh 128" > /proc/net/wlan/cfg 2>/dev/null
            set_cfg_val PROFILE "max_throughput"
            echo "{\"success\":true,\"profile\":\"max_throughput\",\"message\":\"Max Throughput Active: 256-QAM active, 2x2 MIMO 866-1733 Mbps Boost, 160MHz BW, 8K A-MSDU, TCP BBR active\"}"
            ;;
        battery_saver)
            # Standard Power Saving Profile
            cmd_set_cam 0 >/dev/null
            cmd_set_autoperf 0 >/dev/null
            cmd_set_nss 1 >/dev/null
            cmd_set_bw5g 2 >/dev/null
            set_cfg_val PROFILE "battery_saver"
            echo "{\"success\":true,\"profile\":\"battery_saver\",\"message\":\"Battery Saver Active: 802.11 standard power management enabled, 1x1 SISO\"}"
            ;;
        default|*)
            # Reset to defaults
            cmd_set_cam 0 >/dev/null
            cmd_set_qam256 1 >/dev/null
            cmd_set_autoperf 1 >/dev/null
            cmd_set_nss 2 >/dev/null
            cmd_set_bw5g 3 >/dev/null
            set_cfg_val PROFILE "default"
            echo "{\"success\":true,\"profile\":\"default\",\"message\":\"Default Optimized Profile Active (256-QAM + 2x2 MIMO 866 Mbps Boost)\"}"
            ;;
    esac
}

cmd_dump_cfg() {
    if [ -f /proc/net/wlan/cfg ]; then
        echo "{"
        echo "  \"success\": true,"
        echo "  \"config\": ["
        FIRST=1
        RAW_CFG=$(cat /proc/net/wlan/cfg 2>/dev/null)
        while IFS='|' read -r k v; do
            [ -z "$k" ] && continue
            [ "$k" = "DUMP CONFIGURATION :" ] && continue
            [ "$k" = "<KEY|VALUE> OR <D:KEY|VALUE>" ] && continue
            echo "$k" | grep -q "<KEY" && continue
            [ "$k" = "'D': driver part current setting" ] && continue
            echo "$k" | grep -q "^=" && continue
            [ -z "$v" ] && continue
            [ $FIRST -eq 0 ] && echo ","
            printf '    {"key":"%s","val":"%s"}' "$k" "$v"
            FIRST=0
        done <<EOF
$RAW_CFG
EOF
        echo ""
        echo "  ]"
        echo "}"
    else
        echo "{\"success\":false,\"error\":\"/proc/net/wlan/cfg unavailable\"}"
    fi
}

cmd_direct_modem() {
    ACTION="${1:-status}"
    case "$ACTION" in
        enable|1|on)
            # 1. Carrier Entitlement & DUN Bypass
            settings put global tether_dun_required 0 2>/dev/null
            settings put global tether_dun_apn "" 2>/dev/null
            settings put global tether_entitlement_check_state 0 2>/dev/null
            settings put global tether_offload_disabled 1 2>/dev/null
            setprop net.tethering.noprovisioning true 2>/dev/null
            setprop persist.sys.tether.noprovisioning true 2>/dev/null

            # 2. Kernel Forwarding & Socket Wire-Speed Optimizations
            sysctl -w net.ipv4.ip_forward=1 2>/dev/null || true
            sysctl -w net.ipv4.conf.all.forwarding=1 2>/dev/null || true
            sysctl -w net.ipv6.conf.all.forwarding=1 2>/dev/null || true
            sysctl -w net.ipv4.conf.all.rp_filter=0 2>/dev/null || true
            sysctl -w net.ipv4.conf.default.rp_filter=0 2>/dev/null || true
            sysctl -w net.ipv4.conf.swlan0.rp_filter=0 2>/dev/null || true
            sysctl -w net.ipv4.conf.ap0.rp_filter=0 2>/dev/null || true
            sysctl -w net.ipv4.tcp_slow_start_after_idle=0 2>/dev/null || true
            sysctl -w net.core.netdev_max_backlog=10000 2>/dev/null || true
            sysctl -w net.core.somaxconn=4096 2>/dev/null || true

            # 3. TTL Normalization (Prevent hop-count carrier tethering detection)
            sysctl -w net.ipv4.ip_default_ttl=64 2>/dev/null || true
            sysctl -w net.ipv6.conf.all.hop_limit=64 2>/dev/null || true
            iptables -w 2 -t mangle -D POSTROUTING -j TTL --ttl-set 64 2>/dev/null || true
            iptables -w 2 -t mangle -I POSTROUTING 1 -j TTL --ttl-set 64 2>/dev/null || true

            # 4. TCP MSS PMTU Clamping (Eliminates MTU packet drops on LTE/5G bearers)
            iptables -w 2 -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
            iptables -w 2 -t mangle -I FORWARD 1 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
            ip6tables -w 2 -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
            ip6tables -w 2 -t mangle -I FORWARD 1 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true

            # 5. Clean DNS Shield (Redirect Hotspot DNS queries to 1.1.1.1 / 8.8.8.8)
            iptables -w 2 -t nat -D PREROUTING -p udp --dport 53 -j DNAT --to-destination 1.1.1.1:53 2>/dev/null || true
            iptables -w 2 -t nat -I PREROUTING 1 -p udp --dport 53 -j DNAT --to-destination 1.1.1.1:53 2>/dev/null || true
            iptables -w 2 -t nat -D PREROUTING -p tcp --dport 53 -j DNAT --to-destination 1.1.1.1:53 2>/dev/null || true
            iptables -w 2 -t nat -I PREROUTING 1 -p tcp --dport 53 -j DNAT --to-destination 1.1.1.1:53 2>/dev/null || true

            # 6. Wire-Speed Forwarding Chain (Bypasses all Android tetherctrl/quota filters)
            iptables -w 2 -N PURE_FORWARD 2>/dev/null || iptables -w 2 -F PURE_FORWARD
            iptables -w 2 -A PURE_FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -i swlan+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -o swlan+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -i ap0 -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -o ap0 -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -i rndis+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -o rndis+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -i usb+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -o usb+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -i eth+ -j ACCEPT
            iptables -w 2 -A PURE_FORWARD -o eth+ -j ACCEPT
            iptables -w 2 -D FORWARD -j PURE_FORWARD 2>/dev/null || true
            iptables -w 2 -I FORWARD 1 -j PURE_FORWARD 2>/dev/null || true

            # 7. Direct Cellular Modem NAT Masquerade
            iptables -w 2 -t nat -N PURE_NAT 2>/dev/null || iptables -w 2 -t nat -F PURE_NAT
            iptables -w 2 -t nat -A PURE_NAT -o rmnet+ -j MASQUERADE
            iptables -w 2 -t nat -A PURE_NAT -o v4-rmnet+ -j MASQUERADE
            iptables -w 2 -t nat -A PURE_NAT -o ccmni+ -j MASQUERADE
            iptables -w 2 -t nat -A PURE_NAT -o pdp+ -j MASQUERADE
            iptables -w 2 -t nat -D POSTROUTING -j PURE_NAT 2>/dev/null || true
            iptables -w 2 -t nat -I POSTROUTING 1 -j PURE_NAT 2>/dev/null || true

            # 8. IPv6 Forwarding Wire-Speed Passthrough
            ip6tables -w 2 -N PURE_FORWARD_V6 2>/dev/null || ip6tables -w 2 -F PURE_FORWARD_V6
            ip6tables -w 2 -A PURE_FORWARD_V6 -m state --state ESTABLISHED,RELATED -j ACCEPT
            ip6tables -w 2 -A PURE_FORWARD_V6 -i swlan+ -j ACCEPT
            ip6tables -w 2 -A PURE_FORWARD_V6 -o swlan+ -j ACCEPT
            ip6tables -w 2 -A PURE_FORWARD_V6 -i ap0 -j ACCEPT
            ip6tables -w 2 -A PURE_FORWARD_V6 -o ap0 -j ACCEPT
            ip6tables -w 2 -A PURE_FORWARD_V6 -i rndis+ -j ACCEPT
            ip6tables -w 2 -A PURE_FORWARD_V6 -o rndis+ -j ACCEPT
            ip6tables -w 2 -D FORWARD -j PURE_FORWARD_V6 2>/dev/null || true
            ip6tables -w 2 -I FORWARD 1 -j PURE_FORWARD_V6 2>/dev/null || true

            # 9. Dynamic Policy Routing Setup
            sync_direct_routing

            set_cfg_val DIRECT_MODEM_HOTSPOT 1
            echo "{\"success\":true,\"enabled\":true,\"message\":\"Clean Direct Modem-to-Hotspot Passthrough & Carrier Bypass ENABLED\"}"
            ;;
        disable|0|off)
            iptables -w 2 -D FORWARD -j PURE_FORWARD 2>/dev/null || true
            iptables -w 2 -F PURE_FORWARD 2>/dev/null || true
            iptables -w 2 -X PURE_FORWARD 2>/dev/null || true
            ip6tables -w 2 -D FORWARD -j PURE_FORWARD_V6 2>/dev/null || true
            ip6tables -w 2 -F PURE_FORWARD_V6 2>/dev/null || true
            ip6tables -w 2 -X PURE_FORWARD_V6 2>/dev/null || true

            iptables -w 2 -t nat -D POSTROUTING -j PURE_NAT 2>/dev/null || true
            iptables -w 2 -t nat -F PURE_NAT 2>/dev/null || true
            iptables -w 2 -t nat -X PURE_NAT 2>/dev/null || true

            iptables -w 2 -t mangle -D POSTROUTING -j TTL --ttl-set 64 2>/dev/null || true
            iptables -w 2 -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
            iptables -w 2 -t nat -D PREROUTING -p udp --dport 53 -j DNAT --to-destination 1.1.1.1:53 2>/dev/null || true
            iptables -w 2 -t nat -D PREROUTING -p tcp --dport 53 -j DNAT --to-destination 1.1.1.1:53 2>/dev/null || true

            for p in 7000 7001 7002 7003 7004 7005 7010 7011 7012 7013 7014 7015; do
                ip rule del pref "$p" 2>/dev/null || true
                ip -6 rule del pref "$p" 2>/dev/null || true
            done

            set_cfg_val DIRECT_MODEM_HOTSPOT 0
            echo "{\"success\":true,\"enabled\":false,\"message\":\"Direct Modem-to-Hotspot Passthrough disabled\"}"
            ;;
        status|*)
            DM_CFG=$(get_cfg_val DIRECT_MODEM_HOTSPOT)
            [ -z "$DM_CFG" ] && DM_CFG="1"
            DM_ACTIVE=false
            if iptables -w 2 -L FORWARD -n 2>/dev/null | grep -q "PURE_FORWARD"; then
                DM_ACTIVE=true
            fi
            echo "{\"success\":true,\"enabled\":$([ "$DM_CFG" = "1" ] && echo true || echo false),\"active\":$DM_ACTIVE}"
            ;;
    esac
}

case "$1" in
    status)
        cmd_status
        ;;
    set_qam256)
        cmd_set_qam256 "$2"
        ;;
    set_cam)
        cmd_set_cam "$2"
        ;;
    set_autoperf)
        cmd_set_autoperf "$2"
        ;;
    set_dbdc)
        cmd_set_dbdc "$2"
        ;;
    set_nss)
        cmd_set_nss "$2"
        ;;
    set_bw5g)
        cmd_set_bw5g "$2"
        ;;
    set_country)
        cmd_set_country "$2"
        ;;
    set_tcp)
        cmd_set_tcp "$2"
        ;;
    set_wlan_cfg)
        cmd_set_wlan_cfg "$2" "$3"
        ;;
    set_wifi)
        cmd_set_wifi "$2"
        ;;
    set_hotspot)
        cmd_set_hotspot "$2"
        ;;
    set_hotspot_cfg)
        cmd_set_hotspot_cfg "$2" "$3" "$4" "$5"
        ;;
    block_mac)
        cmd_block_mac "$2"
        ;;
    unblock_mac)
        cmd_unblock_mac "$2"
        ;;
    apply_profile)
        cmd_apply_profile "$2"
        ;;
    revert)
        cmd_revert
        ;;
    dump_cfg)
        cmd_dump_cfg
        ;;
    direct_modem)
        cmd_direct_modem "$2"
        ;;
    *)
        echo "Usage: wifi_master {status|set_qam256|set_cam|set_autoperf|set_dbdc|set_nss|set_bw5g|set_country|set_tcp|set_wlan_cfg|set_wifi|set_hotspot|set_hotspot_cfg|block_mac|unblock_mac|apply_profile|revert|dump_cfg|direct_modem}"
        exit 1
        ;;
esac

exit 0
